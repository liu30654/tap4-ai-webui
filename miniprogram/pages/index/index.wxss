/* pages/index/index.wxss */

.entry {
  min-height: 100vh;
  padding: 120rpx 56rpx 80rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* —— 插画 —— */
.scene {
  width: 360rpx;
  height: 280rpx;
  position: relative;
  margin-bottom: 80rpx;
}
.scene-window {
  position: absolute;
  top: 0; left: 60rpx;
  width: 240rpx;
  height: 200rpx;
  border: 2rpx solid #3C3530;
  border-radius: 8rpx;
  overflow: hidden;
  background: linear-gradient(180deg, #EFE6D6 0%, #F6EFE2 100%);
}
.scene-window::before {
  /* 窗户中线 */
  content: '';
  position: absolute;
  top: 0; left: 50%;
  width: 2rpx; height: 100%;
  background: #3C3530;
}
.scene-window::after {
  content: '';
  position: absolute;
  top: 50%; left: 0;
  height: 2rpx; width: 100%;
  background: #3C3530;
}
.scene-mountains {
  position: absolute;
  bottom: 0;
  left: -10rpx;
  width: 260rpx;
  height: 80rpx;
  background: #6B8E9F;
  clip-path: polygon(0% 100%, 14% 50%, 26% 70%, 42% 30%, 60% 60%, 80% 25%, 100% 60%, 100% 100%);
  opacity: 0.55;
}
.scene-mountains.near {
  height: 56rpx;
  background: #3C3530;
  opacity: 0.7;
  clip-path: polygon(0% 100%, 18% 60%, 36% 80%, 56% 50%, 78% 75%, 100% 55%, 100% 100%);
}
.scene-sun {
  position: absolute;
  top: 28rpx; right: 32rpx;
  width: 36rpx; height: 36rpx;
  border-radius: 50%;
  background: #D4B896;
  opacity: 0.85;
}
.scene-table {
  position: absolute;
  bottom: 0; left: 0;
  width: 100%;
  height: 60rpx;
  border-top: 2rpx solid #3C3530;
}
.scene-cup {
  position: absolute;
  left: 50%;
  bottom: 8rpx;
  transform: translateX(-50%);
  width: 56rpx;
  height: 44rpx;
  background: #C97B5C;
  border-radius: 0 0 24rpx 24rpx;
  opacity: 0.9;
}
.scene-cup::after {
  /* 杯把 */
  content: '';
  position: absolute;
  right: -16rpx;
  top: 8rpx;
  width: 18rpx;
  height: 22rpx;
  border: 4rpx solid #C97B5C;
  border-left: none;
  border-radius: 0 12rpx 12rpx 0;
}
.scene-steam {
  position: absolute;
  left: 50%;
  top: -28rpx;
  width: 4rpx;
  height: 24rpx;
  background: #6B8E9F;
  opacity: 0.5;
  border-radius: 2rpx;
  transform-origin: bottom center;
}
.scene-steam.s1 { transform: translateX(-12rpx) rotate(-8deg); animation: steam 3s ease-in-out infinite; }
.scene-steam.s2 { animation: steam 3s ease-in-out infinite 0.5s; }
.scene-steam.s3 { transform: translateX(12rpx) rotate(8deg); animation: steam 3s ease-in-out infinite 1s; }

@keyframes steam {
  0%, 100% { opacity: 0.2; transform: translateY(0) translateX(-12rpx) rotate(-8deg); }
  50%      { opacity: 0.6; transform: translateY(-8rpx) translateX(-12rpx) rotate(-4deg); }
}

/* —— 打字机提问 —— */
.prompt {
  font-size: 38rpx;
  line-height: 1.8;
  color: #3C3530;
  margin-bottom: 64rpx;
  letter-spacing: 2rpx;
  text-align: center;
}
.char {
  display: inline-block;
  opacity: 0;
  animation: char-in 400ms ease forwards;
}
@keyframes char-in {
  from { opacity: 0; transform: translateY(6rpx); }
  to   { opacity: 1; transform: translateY(0); }
}

/* —— 输入区：等打字机结束再浮现 —— */
.input-wrap {
  width: 100%;
  opacity: 0;
  transform: translateY(12rpx);
  transition: opacity 800ms ease, transform 800ms ease;
}
.input-wrap.show {
  opacity: 1;
  transform: translateY(0);
}
.input {
  width: 100%;
  min-height: 200rpx;
  padding: 32rpx;
  background: #FFFFFF;
  border: 1rpx solid rgba(60, 53, 48, 0.12);
  border-radius: 8rpx;
  font-size: 32rpx;
  line-height: 1.8;
  color: #3C3530;
}
.placeholder {
  color: rgba(60, 53, 48, 0.35);
}
.hint {
  text-align: right;
  font-size: 24rpx;
  color: rgba(60, 53, 48, 0.4);
  margin-top: 12rpx;
}
.enter-btn {
  margin-top: 48rpx;
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: transparent;
  color: rgba(60, 53, 48, 0.35);
  border: 1rpx solid rgba(60, 53, 48, 0.2);
  border-radius: 8rpx;
  font-size: 30rpx;
  font-family: inherit;
  transition: all 400ms ease;
}
.enter-btn::after { border: none; }
.enter-btn.on {
  color: #6B8E9F;
  border-color: #6B8E9F;
}
.meta {
  margin-top: 40rpx;
  font-size: 26rpx;
  color: rgba(60, 53, 48, 0.4);
  text-align: center;
  line-height: 1.6;
}
