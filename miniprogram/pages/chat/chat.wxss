/* pages/chat/chat.wxss */

.chat {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #FAF7F2;
}

.thread {
  flex: 1;
  padding: 64rpx 48rpx 32rpx;
  box-sizing: border-box;
}

.msg {
  margin-bottom: 56rpx;
  font-size: 32rpx;
  line-height: 1.9;
  letter-spacing: 0.5rpx;
  word-break: break-word;
  white-space: pre-wrap;
}

/* AI：左对齐，正色 */
.msg-ai {
  color: #3C3530;
  padding-right: 60rpx;
}

/* 用户：右对齐，弱化（这是用户自己的话） */
.msg-user {
  color: rgba(60, 53, 48, 0.7);
  text-align: right;
  padding-left: 80rpx;
  font-style: italic;
}

.char {
  display: inline-block;
  opacity: 0;
  animation: char-in 360ms ease forwards;
}
@keyframes char-in {
  from { opacity: 0; transform: translateY(4rpx); }
  to   { opacity: 1; transform: translateY(0); }
}

.thinking {
  color: rgba(60, 53, 48, 0.4);
  font-size: 32rpx;
  margin-bottom: 40rpx;
  letter-spacing: 8rpx;
  animation: pulse 1.4s ease-in-out infinite;
}
@keyframes pulse {
  0%, 100% { opacity: 0.3; }
  50%      { opacity: 0.7; }
}

.bottom-anchor {
  height: 40rpx;
}

/* —— 底部输入 —— */
.composer {
  border-top: 1rpx solid rgba(60, 53, 48, 0.08);
  background: #FAF7F2;
  padding: 24rpx 40rpx 32rpx;
  transition: opacity 600ms ease;
}
.composer.off {
  opacity: 0.45;
}
.composer-input {
  width: 100%;
  min-height: 80rpx;
  max-height: 320rpx;
  padding: 20rpx 24rpx;
  font-size: 30rpx;
  line-height: 1.7;
  color: #3C3530;
  background: #FFFFFF;
  border: 1rpx solid rgba(60, 53, 48, 0.1);
  border-radius: 8rpx;
}
.placeholder { color: rgba(60, 53, 48, 0.3); }

.composer-row {
  margin-top: 16rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.hint-faint {
  font-size: 24rpx;
  color: rgba(60, 53, 48, 0.35);
}

.send-btn {
  background: transparent;
  color: rgba(60, 53, 48, 0.4);
  border: 1rpx solid rgba(60, 53, 48, 0.2);
  border-radius: 6rpx;
  font-size: 28rpx;
  font-family: inherit;
  padding: 8rpx 32rpx;
  line-height: 1.6;
  transition: color 300ms, border-color 300ms;
}
.send-btn::after { border: none; }
.send-btn.on {
  color: #6B8E9F;
  border-color: #6B8E9F;
}
