<!-- pages/letter/letter.wxml — 阶段 5：信 -->
<view class="letter-page">

  <!-- 信纸展开动画：5-8 秒，分段浮现（PRD §6.4） -->
  <view class="paper {{paperOpen ? 'open' : ''}}">
    <view class="paper-inner">
      <view class="letter-body">
        <block wx:for="{{paragraphs}}" wx:key="index" wx:for-item="p">
          <view
            class="para"
            style="animation-delay: {{index * 600 + 600}}ms">
            {{p}}
          </view>
        </block>
      </view>
    </view>
  </view>

  <view class="actions {{actionsReady ? 'show' : ''}}">
    <button class="act-btn" bindtap="onCopy">复制全文</button>
    <button class="act-btn" bindtap="onSaveImage">保存为长图</button>
  </view>

  <view class="footer {{actionsReady ? 'show' : ''}}">
    <text bindtap="onRestart" class="restart">想清楚了。离开。</text>
  </view>

  <!-- 隐藏的 canvas：保存为图片 -->
  <canvas
    canvas-id="letter-canvas"
    style="position:absolute; left:-9999rpx; top:0; width:{{canvas.w}}px; height:{{canvas.h}}px;"
  ></canvas>
</view>
