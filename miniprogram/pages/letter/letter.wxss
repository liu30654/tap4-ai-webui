/* pages/letter/letter.wxss */

.letter-page {
  min-height: 100vh;
  padding: 64rpx 40rpx 96rpx;
  background: #FAF7F2;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 信纸：从中间向上下展开 */
.paper {
  width: 100%;
  max-width: 640rpx;
  background: #FFFDF8;
  box-shadow: 0 4rpx 24rpx rgba(60, 53, 48, 0.08);
  border-radius: 4rpx;
  overflow: hidden;
  max-height: 0;
  transition: max-height 1400ms cubic-bezier(0.22, 0.61, 0.36, 1);
}
.paper.open {
  max-height: 6000rpx;  /* 大于内容高度即可 */
}

.paper-inner {
  padding: 80rpx 64rpx;
}

.letter-body {
  font-family: "Source Han Serif SC", "Source Han Serif", "Noto Serif CJK SC",
               "Songti SC", "STSong", "SimSun", serif;
  font-size: 34rpx;
  line-height: 2.0;
  color: #3C3530;
  letter-spacing: 1rpx;
}

.para {
  margin-bottom: 32rpx;
  white-space: pre-wrap;
  word-break: break-word;
  opacity: 0;
  animation: para-in 1200ms ease forwards;
}
@keyframes para-in {
  from { opacity: 0; transform: translateY(8rpx); }
  to   { opacity: 1; transform: translateY(0); }
}

.actions {
  margin-top: 64rpx;
  display: flex;
  gap: 24rpx;
  opacity: 0;
  transform: translateY(8rpx);
  transition: opacity 800ms ease, transform 800ms ease;
}
.actions.show {
  opacity: 1;
  transform: translateY(0);
}
.act-btn {
  background: transparent;
  color: #6B8E9F;
  border: 1rpx solid #6B8E9F;
  border-radius: 6rpx;
  font-size: 28rpx;
  font-family: inherit;
  padding: 16rpx 36rpx;
  line-height: 1.5;
}
.act-btn::after { border: none; }

.footer {
  margin-top: 80rpx;
  opacity: 0;
  transition: opacity 800ms ease 200ms;
}
.footer.show { opacity: 1; }
.restart {
  font-size: 26rpx;
  color: rgba(60, 53, 48, 0.4);
  letter-spacing: 1rpx;
}
