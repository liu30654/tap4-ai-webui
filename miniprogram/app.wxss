/**
 * app.wxss — 决策室 v1.0 全局样式
 * 设计基调：安静、温暖、不打扰、有呼吸感
 * 参考 PRD §6 视觉与交互规范
 */

page {
  /* 米白主背景 */
  background-color: #FAF7F2;
  /* 深灰棕主文字 */
  color: #3C3530;
  /* 思源宋体优先；fallback 到系统衬线 */
  font-family: "Source Han Serif SC", "Source Han Serif", "Noto Serif CJK SC",
               "Songti SC", "STSong", "SimSun", serif;
  font-size: 32rpx;
  line-height: 1.8;
  letter-spacing: 0.5rpx;
}

view, text {
  box-sizing: border-box;
}

/* 主色 token —— 给页面引用 */
.c-bg { background-color: #FAF7F2; }
.c-text { color: #3C3530; }
.c-accent { color: #6B8E9F; }   /* 雾蓝 */
.c-wood { color: #D4B896; }     /* 浅木 */
.c-link { color: #C97B5C; }     /* 暖橘 */

/* 整页容器：带左右呼吸 */
.page {
  min-height: 100vh;
  padding: 80rpx 56rpx 64rpx;
  background-color: #FAF7F2;
}

/* 通用按钮：朴素、不带科技感 */
.btn-quiet {
  background: transparent;
  color: #6B8E9F;
  border: 1rpx solid #6B8E9F;
  border-radius: 8rpx;
  font-size: 30rpx;
  padding: 18rpx 40rpx;
  line-height: 1.4;
}
.btn-quiet::after { border: none; }

/* 让长文本柔和地浮现 */
@keyframes soft-fade-in {
  from { opacity: 0; transform: translateY(6rpx); }
  to   { opacity: 1; transform: translateY(0); }
}
.fade-in {
  animation: soft-fade-in 800ms ease both;
}
